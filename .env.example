# Copy this file to .env and fill in your values.
# Never commit the real .env file.

# OpenRouter API key (used for free model benchmarking in Lesson 1.2)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Model profile to use (see config/models.yaml for available profiles)
# Options: openrouter-free, gemma-4-free, gpt-oss-20b-free, gemini-fast, openai-default, etc.
MODEL_PROFILE=openrouter-free

# Direct provider API keys (for later lessons)
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
GROQ_API_KEY=your-groq-api-key-here
MISTRAL_API_KEY=your-mistral-api-key-here
